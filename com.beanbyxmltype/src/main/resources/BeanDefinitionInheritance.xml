<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE beans PUBLIC "-//SPRING//DTD BEAN 2.0//EN"
        "http://www.springframework.org/dtd/spring-beans-2.0.dtd">
<beans>

    <!-- Template Parent Bean -->
    <bean class="com.kw.acedemy.Parent" id="ParentTemplate">
        <property name="name" value="sadhashivam"/>
        <property name="from" value="maharastra"/>
        <property name="wallet" value="true"/>
    </bean>

    <!-- Child bean copies values from ParentTemplate config -->
    <bean class="com.kw.acedemy.Students" id="StudentId" parent="ParentTemplate">
        <property name="studentId" value="5"/>
        <property name="studentName" value="ganesh"/>
    </bean>

</beans>
